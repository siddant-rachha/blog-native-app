{
  "name": "blog-native-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo run:android",
    "ios": "npx npx expo run:ios",
    "web": "npx expo start --web",
    "lint": "npx expo lint",
    "this_is_comment_only": "local-build command is mac os supported only, for windows, build using android studio",
    "local-build": "eas build:configure && eas build --platform android --profile production --local",
    "dev-client": "npx expo start --dev-client",
    "prebuild": "npx expo prebuild",
    "prebuild-clean": "npx expo prebuild --clean",
    "encrypt-file": "read -s -p '🔐 Enter password to encrypt: ' pass && echo && openssl aes-256-cbc -salt -pbkdf2 -in FILE_NAME_FROM_ROOT_PATH -out ENCRYPTED_FILE_NAME -k \"$pass\" && echo '✅ file encrypted!'",
    "decrypt-file": "read -s -p '🔐 Enter password to decrypt: ' pass && echo && openssl aes-256-cbc -d -pbkdf2 -in FILE_NAME_TO_DECRYPT_FROM_ROOT_PATH -out DECRYPTED_FILE_NAME -k \"$pass\" && echo '✅ file decrypted!'"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.3.1",
    "@react-native-firebase/auth": "^23.3.1",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.12.1",
    "expo": "54.0.7",
    "expo-build-properties": "~1.0.8",
    "expo-constants": "~18.0.8",
    "expo-font": "~14.0.7",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-image-picker": "~17.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.4",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "expo-image-manipulator": "~14.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
