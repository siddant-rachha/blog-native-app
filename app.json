{
  "expo": {
    "name": "Blog Native App",
    "slug": "blog-native-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/blog-native-app-icon.png",
    "scheme": "blognativeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidr99.blognativeapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/blog-native-app-icon.png",
        "backgroundImage": "./assets/images/blog-native-app-icon.png",
        "monochromeImage": "./assets/images/blog-native-app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sidr99.blognativeapp",
      // "googleServicesFile": "./google-services.json"
      "googleServicesFile": "/Users/siddant_rachha@optum.com/Documents/learning-projects/blog-native-app/google-services.json" // absolute path is required while using eas local build
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/blog-native-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/blog-native-app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0d5ee6a-128f-4b09-8312-9c77b323004d"
      }
    }
  }
}
